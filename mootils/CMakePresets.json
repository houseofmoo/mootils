{
  "version": 3,
  "configurePresets": [
    {
      "name": "__build-root",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-debug",
      "inherits": "__build-root",
      "displayName": "Linux Debug build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOG_LEVEL": "Debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "__build-root",
      "displayName": "Linux Release build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOG_LEVEL": "Warning"
      }
    },
    {
      "name": "win-debug",
      "inherits": "__build-root",
      "displayName": "Debug build",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOG_LEVEL": "Debug"
      }
    },
    {
      "name": "win-release",
      "inherits": "__build-root",
      "displayName": "Release build",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LOG_LEVEL": "Warning"
      }
    },
    {
      "name": "win-msvc-debug",
      "inherits": "__build-root",
      "displayName": "MSVC Debug build",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "win-msvc-release",
      "inherits": "__build-root",
      "displayName": "MSVC Release build",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "displayName": "Build Linux Debug",
      "configurePreset": "linux-debug",
      "jobs": 0
    },
    {
      "name": "linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release",
      "jobs": 0
    },
    {
      "name": "win-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "win-debug",
      "jobs": 0
    },
    {
      "name": "win-release",
      "displayName": "Build Windows Release",
      "configurePreset": "win-release",
      "jobs": 0
    },
    {
      "name": "win-msvc-debug",
      "displayName": "Build Windows MSVC Debug",
      "configurePreset": "win-msvc-debug",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "win-msvc-release",
      "displayName": "Build Windows MSVC Release",
      "configurePreset": "win-msvc-release",
      "configuration": "Release",
      "jobs": 0
    }
  ]
}