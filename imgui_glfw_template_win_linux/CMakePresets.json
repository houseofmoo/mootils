{
  "version": 3,
  "configurePresets": [
    {
      "name": "__build-root",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-debug",
      "inherits": "__build-root",
      "displayName": "Linux Debug build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "__build-root",
      "displayName": "Linux Release build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "win-debug",
      "inherits": "__build-root",
      "displayName": "Debug build",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-release",
      "inherits": "__build-root",
      "displayName": "Release build",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "displayName": "Build Linux Debug",
      "configurePreset": "linux-debug",
      "jobs": 0
    },
    {
      "name": "linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release",
      "jobs": 0
    },
    {
      "name": "win-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "win-debug",
      "jobs": 0
    },
    {
      "name": "win-release",
      "displayName": "Build Windows Release",
      "configurePreset": "win-release",
      "jobs": 0
    }
  ]
}